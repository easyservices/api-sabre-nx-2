# FastAPI settings
FASTAPI_TITLE=Nextcloud FastAPI
FASTAPI_SUMMARY=REST wrapper around Nextcloud CardDAV/CalDAV
FASTAPI_DESCRIPTION=
FASTAPI_VERSION=0.3.0
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=1225
FASTAPI_RELOAD=false
FASTAPI_LOG_LEVEL=info
# Comma-separated list; use "*" for all
FASTAPI_ALLOWED_HOSTS=*

# Nextcloud endpoints
NEXTCLOUD_INTERNET_URL=https://nextcloud.example.com:8083
NEXTCLOUD_INTRANET_URL=http://localhost:8560

# Authentication cache settings
AUTH_CACHE_TTL=120
AUTH_CACHE_SIZE=100
AUTH_HTTP_TIMEOUT=10.0
# Strong secret used for HMAC-ing cache keys (set to a random value in real deployments)
AUTH_CACHE_SECRET=change-me-to-a-random-hex

# Test users (YAML or JSON as a single-line string). Optional NEXTCLOUD_CALENDAR can
# be set per user to drive which calendar CLI tests should target.
# COMMON_USERS_YAML='{"test4me":{"NEXTCLOUD_USERNAME":"alice","NEXTCLOUD_PASSWORD":"app-password","NEXTCLOUD_CALENDAR":"personal"}}'
